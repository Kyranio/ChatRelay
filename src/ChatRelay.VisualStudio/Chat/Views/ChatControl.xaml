<UserControl x:Class="ChatRelay.Chat.Views.ChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:ChatRelay.Chat.Models"
            >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Markdig.Wpf;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Default foreground for every TextBlock follows the VS theme.
                 Markdig.Wpf's own styles for code blocks / inline code are retheme'd
                 in code-behind (see ChatControl.ApplyTheme) because Markdig
                 parses its emitted XAML in isolation and resolves its resource
                 references before the document reaches our visual tree. -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"/>
            </Style>

            <!-- Reference chips are built in code-behind (CreateReferenceChip)
                 because per-range click handlers and hover X buttons don't
                 map cleanly to a declarative DataTemplate. -->

            <!-- Small "Copy" button that overlays code blocks on hover. Opacity
                 defaults to 0 and is flipped on/off by the containing Border's
                 hover events (see ReplaceCodeParagraph). -->
            <Style x:Key="CopyButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="#80404040"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#C0505050"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E0606060"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small icon button used for the New/Delete session controls.
                 Transparent idle, subtle hover, theme-aware foreground. -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource {x:Static vs:EnvironmentColors.CommandBarMouseOverBackgroundGradientBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Theme-aware ComboBox. Default WPF template hardcodes SystemColors
                 which don't track the VS theme, so we replace it entirely. -->
            <Style x:Key="ThemedComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource {x:Static vs:EnvironmentColors.CommandBarMouseOverBackgroundGradientBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource {x:Static vs:EnvironmentColors.CommandBarSelectedBrushKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ThemedComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                <Setter Property="Background"
                        Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBorderBrushKey}}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboBoxItemStyle}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="2"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Margin="6,0,20,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  IsHitTestVisible="False"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                <Path HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      Width="8" Height="5"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{TemplateBinding Foreground}"
                                      IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       Focusable="False">
                                    <Border Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                                            BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                            BorderThickness="1"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="300">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Apple-green accent send button. We need a ControlTemplate (not just
                 Background setters) because WPF's default button template
                 hard-codes a hover/pressed tint that would otherwise win. -->
            <Style x:Key="ClaudeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#40E0D0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#2EB6AB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#5FE6D8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1F8881"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Permission-bubble action buttons. Theme-aware base + three
                 derived styles that add an accent border to telegraph
                 intent: red for Deny (destructive), neutral for Allow once,
                 brand turquoise for Allow always (the "stickier" decision).
                 Idle / hover / pressed all pull from EnvironmentColors so
                 the bubble blends with whichever VS theme is active. -->
            <Style x:Key="PermissionButtonBaseStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="MinWidth" Value="84"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground"
                        Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                <Setter Property="Background"
                        Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBorderBrushKey}}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource {x:Static vs:EnvironmentColors.CommandBarMouseOverBackgroundGradientBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource {x:Static vs:EnvironmentColors.CommandBarSelectedBrushKey}}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PermissionDenyButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource PermissionButtonBaseStyle}">
                <Setter Property="BorderBrush" Value="#C0392B"/>
            </Style>

            <Style x:Key="PermissionAllowOnceButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource PermissionButtonBaseStyle}"/>

            <Style x:Key="PermissionAllowAlwaysButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource PermissionButtonBaseStyle}">
                <Setter Property="BorderBrush" Value="#40E0D0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="ChatRoot" Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- session toolbar -->
                <RowDefinition Height="*"/>
                <!-- history           -->
                <RowDefinition Height="Auto"/>
                <!-- references        -->
                <RowDefinition Height="Auto"/>
                <!-- input             -->
                <RowDefinition Height="Auto"/>
                <!-- usage status bar  -->
            </Grid.RowDefinitions>

            <!-- Session toolbar: session dropdown + new / delete buttons. -->
            <Grid Grid.Row="0" Margin="4,4,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SessionBox" Grid.Column="0"
                      Height="26" FontSize="11"
                      Style="{StaticResource ThemedComboBoxStyle}"
                      
                      ToolTip="Switch chat session"
                      SelectionChanged="SessionBox_SelectionChanged">
                    <!-- Explicit ItemTemplate instead of DisplayMemberPath because
                     WPF's internal SelectionBoxItemTemplate wiring doesn't
                     always pick up DisplayMemberPath under a custom template. -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ChatSession}">
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="NewSessionButton" Grid.Column="1"
                    Width="36" Height="26"
                    Margin="4,0,0,0"
                    FontSize="12"
                    Content="+💬"
                    ToolTip="New chat"
                    Style="{StaticResource IconButtonStyle}"
                    Click="NewSessionButton_Click"/>
                <Button x:Name="DeleteSessionButton" Grid.Column="2"
                    Width="36" Height="26"
                    Margin="2,0,0,0"
                    FontSize="12"
                    Content="×💬"
                    ToolTip="Delete this chat"
                    Style="{StaticResource IconButtonStyle}"
                    Click="DeleteSessionButton_Click"/>
            </Grid>

            <!-- Conversation history -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" Margin="4">
                    <StackPanel x:Name="HistoryPanel"/>
                </ScrollViewer>

                <!-- Home-state pane: shown when no session is selected (no
                 conversation in progress). Centered hint + a clickable
                 recent-sessions list that fills in once the background
                 session loader finishes. Toggled from code-behind on
                 VM.CurrentSession changes. -->
                <StackPanel x:Name="HomePane"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="Write a message to start a new chat, or navigate to a previous chat."
                           FontSize="13"
                           Opacity="0.55"
                           HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SessionLoadingHint"
                           Text="Older conversations are still loading..."
                           FontSize="13"
                           Opacity="0.55"
                           HorizontalAlignment="Center"
                           FontWeight="Thin"/>
                    <TextBlock x:Name="HomeRecentHeader"
                           Text="Most recent chats"
                           FontSize="11"
                           Opacity="0.45"
                           Margin="0,18,0,4"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>
                    <StackPanel x:Name="HomeRecentList"/>
                </StackPanel>
            </Grid>

            <!-- Pinned references (from "Send Selection"): clickable chips in a
             collapsible group. Chips are added/removed from code in response
             to _references.CollectionChanged. -->
            <Expander x:Name="ReferencesExpander" Grid.Row="2" Margin="4,0"
                  Header="References"
                  IsExpanded="True"
                  Visibility="Collapsed"
                  BorderThickness="0"
                  Background="Transparent"
                  Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}">
                <StackPanel x:Name="ReferencesList"/>
            </Expander>

            <!-- Input area: one rounded container. The TextBox fills the whole
             width with a transparent background; the orange send button floats
             inside, docked to the bottom-right. -->
            <Border Grid.Row="3" Margin="4"
                CornerRadius="8"
                BorderThickness="1"
                MinHeight="100" MaxHeight="240"
                Background="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBorderBrushKey}}">
                <DockPanel LastChildFill="True">
                    <!-- Bottom bar: session-config dropdowns on the left, send button on the right. -->
                    <Grid DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,5,0,6">
                            <!-- Model dropdown. ItemsSource is set in code-behind to a
                             grouped CollectionView over the registry's models;
                             the ItemTemplate below renders bold name + normal
                             version, and the group header names the adapter. -->
                            <ComboBox x:Name="ModelBox"
                                  MinWidth="160" Height="26" FontSize="11"
                                  Margin="4,0,0,0"
                                  Style="{StaticResource ThemedComboBoxStyle}"
                                  ToolTip="Model to send to. Grouped by backend; auto-detected on startup."
                                  SelectionChanged="ModelBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:AiModel}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                                            <TextBlock Text=" "/>
                                            <TextBlock Text="{Binding Version}" Opacity="0.75"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.55"
                                                       Margin="4,6,4,2"
                                                       FontSize="10"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ComboBox.GroupStyle>
                            </ComboBox>
                        </StackPanel>

                        <!-- Gear + Send live together on the right. Gear is plain
                         icon-button (matches the session +/× buttons); Send is
                         the apple-green accent primary. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,5,6,6">
                            <!-- MCP tool-gate button. Opens a popup (McpToolMenu)
                             anchored to this button; click outside closes.
                             Icon is the official MCP mark (three intertwined
                             stroke paths forming a stylised M). Rendered as
                             inline XAML Path geometry so it inherits the
                             theme's text color and scales cleanly without a
                             bitmap asset. -->
                            <Button x:Name="McpButton"
                                Width="32" Height="32"
                                Margin="0,0,4,0"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Show / hide MCP tools available to the model"
                                Click="McpButton_Click">
                                <Viewbox Width="18" Height="18">
                                    <!-- 195x195 native viewport — covers the
                                     logo's bounding box with a bit of
                                     breathing room on each side. -->
                                    <Canvas Width="195" Height="195">
                                        <Path Data="M25 97.8528L92.8823 29.9706C102.255 20.598 117.451 20.598 126.823 29.9706V29.9706C136.196 39.3431 136.196 54.5391 126.823 63.9117L75.5581 115.177 M76.2653 114.47L126.823 63.9117C136.196 54.5391 151.392 54.5391 160.765 63.9117L161.118 64.2652C170.491 73.6378 170.491 88.8338 161.118 98.2063L99.7248 159.6C96.6006 162.724 96.6006 167.789 99.7248 170.913L112.331 183.52 M109.853 46.9411L59.6482 97.1457C50.2757 106.518 50.2757 121.714 59.6482 131.087V131.087C69.0208 140.459 84.2168 140.459 93.5894 131.087L143.794 80.8822"
                                          Stroke="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"
                                          StrokeThickness="12"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Popup x:Name="McpPopup"
                               PlacementTarget="{Binding ElementName=McpButton}"
                               Placement="Top"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               HorizontalOffset="0"
                               VerticalOffset="-4">
                                <!-- Content set in code-behind so the UserControl
                                 can be constructed once and reused across opens. -->
                            </Popup>
                            <!-- Settings gear. U+2699 renders as a fuzzy color
                             emoji on Segoe UI Symbol / Segoe Fluent Icons;
                             inline Path gives us a crisp monochrome glyph
                             that tracks the VS theme via the Foreground
                             brush. Geometry is the Material "settings"
                             icon in a 24x24 box. -->
                            <Button x:Name="SettingsButton"
                                Width="32" Height="32"
                                Margin="0,0,4,0"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Settings"
                                Click="SettingsButton_Click">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                                      Fill="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                                </Viewbox>
                            </Button>
                            <Button x:Name="SendButton"
                                Width="32" Height="32"
                                Content="&#x23CE;"
                                Style="{StaticResource ClaudeButtonStyle}"
                                ToolTip="Send (Enter)"
                                Click="SendButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="InputBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Hidden"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8,8,8,0"
                         Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"
                         CaretBrush="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"
                         PreviewKeyDown="InputBox_PreviewKeyDown"/>
                </DockPanel>
            </Border>

            <!-- Session usage totals. Populated in code-behind after each
             UsageUpdate event; collapsed while there's nothing to show. -->
            <TextBlock x:Name="UsageStatusBar"
                   Grid.Row="4"
                   Margin="8,2,8,4"
                   FontSize="10"
                   Opacity="0.6"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"
                   Visibility="Collapsed"/>
        </Grid>

        <!-- Loading overlay covers everything until VM.IsLoading flips
             false. Blocks all interaction so users can't race the
             startup sequence (model picker, sessions list, etc.). -->
        <Border x:Name="LoadingOverlay"
                Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
            <TextBlock Text="Loading…"
                       FontSize="13"
                       Opacity="0.6"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"/>
        </Border>
    </Grid>
</UserControl>
