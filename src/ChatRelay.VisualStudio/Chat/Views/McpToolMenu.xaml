<UserControl x:Class="ChatRelay.Chat.Views.McpToolMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">
    <!--
        Contents of the MCP tool popup. Not a window — hosted inside a WPF
        Popup in ChatControl; the Popup handles click-outside-closes
        via StaysOpen=false. The border below gives the menu its own visual
        frame independent of whatever surface the popup lands on.
    -->
    <Border Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
            BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBorderBrushKey}}"
            BorderThickness="1"
            CornerRadius="4"
            MinWidth="280"
            MaxWidth="380"
            MaxHeight="420">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- header / status -->
                <RowDefinition Height="*"/>     <!-- scrollable body -->
                <RowDefinition Height="Auto"/>  <!-- footer / refresh -->
            </Grid.RowDefinitions>

            <!-- Header: title + loading state. Always visible. -->
            <Grid Grid.Row="0" Margin="10,8,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="MCP tools"
                           FontWeight="SemiBold"
                           FontSize="12"/>

                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           FontSize="10"
                           Opacity="0.6"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Body: per-server expanders with tool checkboxes. Populated
                 in code-behind when the menu opens so we don't pay the
                 server-handshake cost until the user actually looks. -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,0,6">
                <StackPanel x:Name="ServersPanel"/>
            </ScrollViewer>

            <!-- Footer: explanatory text + refresh. Kept minimal — the menu
                 is meant to feel lightweight, not like a settings page. -->
            <Grid Grid.Row="2"
                  Margin="10,6,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           FontSize="10"
                           Opacity="0.6"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="Unchecked tools stay hidden from the model. The server keeps running."/>

                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Content="Refresh"
                        FontSize="10"
                        Padding="8,2"
                        Margin="6,0,0,0"
                        Cursor="Hand"
                        Click="RefreshButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
