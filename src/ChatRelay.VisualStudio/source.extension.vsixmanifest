<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="Kyranio.ChatRelay.369e56a8-26fe-4ab2-af02-84e6ad20eb51" Version="0.1" Language="en-US" Publisher="Kyran.io" />
    <DisplayName>ChatRelay for Visual Studio</DisplayName>
    <Description xml:space="preserve">Chat with Claude inside Visual Studio — and any other AI backend you have installed. ChatRelay auto-detects Claude CLI (subscription login), the Anthropic API, and local Ollama, then groups every available model under one dropdown in a dockable tool window. Right-click any editor selection or Solution Explorer file to pin it as a reference in the next message. Configure MCP servers globally or per-solution — tools work across every backend.</Description>
    <License>LICENSE</License>
    <GettingStartedGuide>https://github.com/Kyranio/ChatRelay</GettingStartedGuide>
    <ReleaseNotes>https://github.com/Kyranio/ChatRelay/blob/main/CHANGELOG.md</ReleaseNotes>
    <Tags>chat, ai, llm, claude, anthropic, ollama, mcp, model-context-protocol, copilot, assistant</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14, )">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.14, )">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.14, )">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14, )" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
