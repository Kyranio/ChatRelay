<Window x:Class="ChatRelay.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vs="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        Title="ChatRelay — Settings"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
        Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"/>
        </Style>
        <!-- List of categories on the left. Kept minimal — the tool window's
             themed brushes carry the look. -->
        <Style x:Key="CategoryListStyle" TargetType="ListBox">
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBorderBrushKey}}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"/>
        </Style>
        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static vs:EnvironmentColors.CommandBarMouseOverBackgroundGradientBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static vs:EnvironmentColors.CommandBarSelectedBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Reuse the apple-green accent button from the chat control for
             consistency with the main Send button. -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#40E0D0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2EB6AB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5FE6D8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F8881"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Themed flat secondary button for Cancel. -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBorderBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource {x:Static vs:EnvironmentColors.CommandBarMouseOverBackgroundGradientBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- Segmented "Off / On" toggle — still a CheckBox under the hood
             (for IsChecked binding + keyboard support), just with a custom
             template that renders as two pill halves. Active half is
             apple-green; inactive half is outlined. -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border BorderBrush="#2EB6AB"
                                BorderThickness="1"
                                CornerRadius="3"
                                Height="22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="OffHalf" Grid.Column="0"
                                        Background="#40E0D0"
                                        CornerRadius="2,0,0,2">
                                    <TextBlock x:Name="OffText"
                                               Text="Off"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="OnHalf" Grid.Column="1"
                                        Background="Transparent"
                                        CornerRadius="0,2,2,0">
                                    <TextBlock x:Name="OnText"
                                               Text="On"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#40E0D0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OffHalf" Property="Background" Value="Transparent"/>
                                <Setter TargetName="OffText" Property="Foreground" Value="#40E0D0"/>
                                <Setter TargetName="OnHalf" Property="Background" Value="#40E0D0"/>
                                <Setter TargetName="OnText" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Category list on the left. Selection drives the
                 right-panel visibility via code-behind — each panel is
                 defined below and gets Visible/Collapsed per selection. -->
            <ListBox x:Name="CategoryList" Grid.Column="0"
                     Style="{StaticResource CategoryListStyle}"
                     ItemContainerStyle="{StaticResource CategoryItemStyle}"
                     SelectionChanged="CategoryList_SelectionChanged">
                <ListBoxItem Content="General" IsSelected="True"/>
                <ListBoxItem Content="Permissions"/>
                <ListBoxItem Content="MCP Servers"/>
            </ListBox>

            <Grid Grid.Column="1">
                <!-- ================================ General ================================ -->
                <StackPanel x:Name="GeneralPanel" Margin="16,12">
                    <TextBlock Text="General"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <CheckBox x:Name="AutoAttachCheck"
                              Style="{StaticResource CheckBoxStyle}"
                              Content="Auto-attach the currently-visible file on every send"
                              ToolTip="When off, only explicitly-pinned references are sent."/>

                    <CheckBox x:Name="ThinkingExpandedCheck"
                              Style="{StaticResource CheckBoxStyle}"
                              Content="Expand the 💭 Thinking section by default"
                              ToolTip="Show reasoning content open rather than collapsed."/>

                    <TextBlock Margin="0,18,0,0"
                               Opacity="0.6"
                               FontSize="11"
                               TextWrapping="Wrap">
                        Settings are stored at
                        <Run FontFamily="Consolas" Text="%LocalAppData%\ChatRelay\settings.json"/>
                        and apply to every solution.
                    </TextBlock>
                </StackPanel>

                <!-- ================================ Permissions ================================ -->
                <!-- Scrollable so the five sections still fit on small
                     tool-window sizes without cramming. -->
                <ScrollViewer x:Name="PermissionsPanel"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed"
                              Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Permissions"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <TextBlock Margin="0,4,0,14"
                                   Opacity="0.7"
                                   FontSize="11"
                                   Text="Global permissions for all models. Be careful with these settings!"/>

                        <!-- Always-allowed tools (was: Allowed tools). -->
                        <TextBlock Text="Always allowed tools"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                        <TextBlock Margin="0,0,0,4"
                                   Opacity="0.7"
                                   FontSize="11"
                                   TextWrapping="Wrap">
                            One pattern per line, e.g.
                            <Run FontFamily="Consolas" Text="Bash"/>,
                            <Run FontFamily="Consolas" Text="Bash(git:*)"/>,
                            <Run FontFamily="Consolas" Text="Edit"/>,
                            <Run FontFamily="Consolas" Text="mcp__server__tool"/>.
                            Items added via "Allow always" in the permission bubble land here.
                            Passed as <Run FontFamily="Consolas" Text="--allowedTools"/>.
                        </TextBlock>
                        <Border BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Height="80">
                            <TextBox x:Name="AllowedToolsBox"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Padding="6"
                                     Background="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                                     Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"
                                     BorderThickness="0"/>
                        </Border>

                        <!-- Blocked tools (was: Disallowed tools). -->
                        <TextBlock Text="Blocked tools"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Margin="0,14,0,4"/>
                        <TextBlock Margin="0,0,0,4"
                                   Opacity="0.7"
                                   FontSize="11"
                                   TextWrapping="Wrap">
                            Tools in this list are always refused, no approval prompt.
                            Passed as <Run FontFamily="Consolas" Text="--disallowedTools"/>.
                        </TextBlock>
                        <Border BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Height="80">
                            <TextBox x:Name="DisallowedToolsBox"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Padding="6"
                                     Background="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                                     Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"
                                     BorderThickness="0"/>
                        </Border>

                        <!-- Additional directories (moved from General). -->
                        <TextBlock Text="Additional allowed directories"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Margin="0,14,0,4"/>
                        <TextBlock Margin="0,0,0,4"
                                   Opacity="0.7"
                                   FontSize="11"
                                   TextWrapping="Wrap">
                            Full paths the CLI can read/write outside the current solution
                            (one per line, e.g.
                            <Run FontFamily="Consolas" Text="C:\Users\you\Documents"/>).
                            Passed as <Run FontFamily="Consolas" Text="--add-dir"/>.
                        </TextBlock>
                        <Border BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Height="70">
                            <TextBox x:Name="AdditionalDirsBox"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Padding="6"
                                     Background="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBackgroundBrushKey}}"
                                     Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"
                                     BorderThickness="0"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================================ MCP Servers ================================ -->
                <Grid x:Name="McpPanel" Margin="16,12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- title        -->
                        <RowDefinition Height="*"/>     <!-- server list  -->
                        <RowDefinition Height="Auto"/>  <!-- footer hint  -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="MCP Servers"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <!-- Boxed list of configured servers. When no servers
                         exist, the empty-state panel takes over the whole
                         box; otherwise the ItemsControl renders one row per
                         server via McpServerRowTemplate. -->
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBorderBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="2">
                        <Grid>
                            <ScrollViewer x:Name="McpServerListScroll"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="McpServerList"
                                              Padding="6"/>
                            </ScrollViewer>

                            <!-- Empty state, centered, shown only when the
                                 ItemsControl has no items. Visibility is
                                 toggled from code-behind. -->
                            <StackPanel x:Name="McpEmptyState"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock Text="No MCP connections configured!"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Opacity="0.75"/>
                                <!-- Global on top, project below. Stacked
                                     vertically because the two-line content
                                     (label + path) + the longer "Add
                                     configuration file…" fallbacks would
                                     stretch a horizontal row uncomfortably
                                     wide. HorizontalAlignment=Center on the
                                     StackPanel + HorizontalAlignment=Stretch
                                     on the buttons makes both match the
                                     width of the wider one. -->
                                <StackPanel Orientation="Vertical"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Center">
                                    <Button x:Name="ConfigureGlobalButton"
                                            Content="Configure globally for current user"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,0,6"
                                            HorizontalAlignment="Stretch"
                                            Click="ConfigureGlobalButton_Click"/>
                                    <Button x:Name="ConfigureProjectButton"
                                            Content="Configure for project"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Click="ConfigureProjectButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Configuration files registry: user-managed list of
                         .chatrelay.mcp.json files the extension loads. Populated
                         in RebuildMcpFileList. + button opens a ContextMenu
                         with Global / Project choices → file picker. -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Configuration files"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="AddMcpFileButton"
                                    Grid.Column="1"
                                    Content="+"
                                    Width="32" Height="32"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Padding="0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="Add a configuration file"
                                    Click="AddMcpFileButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="AddMcpFileMenu">
                                        <MenuItem Header="Add global configuration file"
                                                  Click="AddGlobalMcpFileMenu_Click"/>
                                        <MenuItem Header="Add project-scoped configuration file"
                                                  Click="AddProjectMcpFileMenu_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBorderBrushKey}}"
                                BorderThickness="1"
                                CornerRadius="2"
                                MinHeight="60"
                                MaxHeight="180">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="McpFileList" Padding="4"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- OK / Cancel footer. -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource {x:Static vs:EnvironmentColors.ComboBoxBorderBrushKey}}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Cancel"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click"
                        IsCancel="True"/>
                <Button x:Name="OkButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Save"
                        Click="OkButton_Click"
                        IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
