<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hosts the named-pipe server the PermissionBroker.exe MCP tool
    connects to when Claude CLI needs a tool-use approval. The host
    raises RequestReceived when a request comes in; the shell
    surfaces the approval bubble via JSON-RPC; the decision flows
    back here. See ARCHITECTURE.md §3.5 for the full flow.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ChatRelay</RootNamespace>
    <AssemblyName>ChatRelay.Permissions</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChatRelay.Logging\ChatRelay.Logging.csproj" />
  </ItemGroup>

</Project>
